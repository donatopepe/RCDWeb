<div id="resultCanali" class="" style="display: none"></div>
<script>
                    function alertCanali(message) {
            if (message.length > 0) {
                $("#resultCanali").empty();
                console.log("alert:" + message);
                $("<div>").text(message).appendTo("#resultCanali");
                $("#resultCanali").scrollTop(0);
                var opt = {
                    autoOpen: false,
                    modal: true,
                    width: "auto",
                    height: "auto",
                    title: 'Alert',
                    buttons: {
                        Chiudi: function () {
                            $(this).dialog("close");
                            $(this).dialog("destroy");
                        }
                    },
                };
                $('#resultCanali').dialog(opt).dialog('open');
            }
            };
            function ControlloCostiCanali() {
                var ValoreCanaleConsegna = $("select#CanaleConsegna_Id").val();
                if ((presentecostonullo) && (
                    @*(ValoreCanaleConsegna == "@ViewBag.CanaleFilialeID") ||*@
                    ($("input#SpesaAddebitabile").is(':checked'))))
                {
                    alertCanali("Attenzione controllare costo documenti!");
                }
            };

</script>


