                function DataEvasione(value) {
                    var richiesta = $("#DataRichiesta").val();

                    var dateString = richiesta; // Oct 23
                    var words = dateString.split('/');

                    var dd = words[0];
                    var mm = words[1];
                    var y = words[2];
                    var dateObject = new Date(mm + '/' + dd + '/' + y);
                    //alert("dopo split " + dateObject.toLocaleDateString())

                    var numberOfDaysToAdd = @ViewBag.giorniscadenzabanca;//evasione 90gg
