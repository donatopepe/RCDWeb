                        || (ricezioneId && consegnaId && ricezioneId == 3 && consegnaId == 1)
                        || (ricezioneId && (ricezioneId == 2 || ricezioneId == 4))) {
                        console.log("Bottone documenti in giacenza visibile");
                        $('#docGiacenza').show();
