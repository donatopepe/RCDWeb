            function ConfermaOK(elemento, submitName, submitValue, form) {
                console.log("submitValue:" + submitValue);
                var conferma = submitValue.indexOf("Conferma");
                console.log("conferma:" + conferma);
                var StatiMotivazione = @Html.Raw(Json.Encode(@ViewBag.StatiMotivazione));
                for (var i = 0; i < StatiMotivazione.length; i++) {
                    console.log("StatiMotivazione:" + StatiMotivazione[i]);
                }
                var ChiediMotivazione = false;
                for (var i = 0; i < StatiMotivazione.length; i++) {
                    var ind = submitValue.indexOf(StatiMotivazione[i]);
                    console.log("StatiMotivazione:" + StatiMotivazione[i] + " Submitvalue:" + submitValue + " IndexOf:" + ind);
                    if (ind >= 0) ChiediMotivazione = true;
                }
                //if ((conferma >= 0) && ((annulla >= 0) || (respingixmod >= 0) || (archivia >= 0) || (respinta >= 0) ))
                if ((conferma >= 0) && (ChiediMotivazione)) {
                    console.log("Chiedo motivazione");
                    var opt = {
                        autoOpen: false,
                        modal: true,
                        width: "800px",
                        height: "auto",
                        title: 'Inserire motivazione'
                    };
                    $('#imputMotivazione').val($('#Motivazione').val());   ///////////////////// ripropongo motivazione memorizzata
                    $("#finestramotivazione").dialog({
                        options:opt,
                        buttons: {
                            "Conferma": function () {
                                console.log("Elemento:" + elemento);

                                var motivazione = $('#imputMotivazione').val(); 
                                $('#Motivazione').val(motivazione);
                                var formdataxconferma = $("#RichiestaForm")[0];
                                var dataxconferma = new FormData(formdataxconferma);
                                GestionePost(elemento, "operationType", submitValue+"Ok", form, dataxconferma);
                                $(this).dialog("close");

                            },
                            "Cancella": function () {
                                $('#Motivazione').val("");
                                $(this).dialog("close");
                                $(elemento).removeAttr("disabled");
                            }
                        }
                    });

                }
                else {
                    $('#Motivazione').val('');
                    var formdataxconferma = $("#RichiestaForm")[0];
                    var dataxconferma = new FormData(formdataxconferma);
                    GestionePost(elemento, "operationType", submitValue + "Ok", form, dataxconferma);
                }
            }


