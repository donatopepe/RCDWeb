                regForm.submit(
                    function (event) {
                        console.log("Submit default prevenuto");
                        event.preventDefault();

                    }
                );
                var id = $("#Id");
                console.log("ID: " + id.val());
                if (id.val() =="@Guid.Empty") {
                    $(".Id_Empty").hide();
                    console.log("Id_Empty: hide");
                } else {
                    $(".Id_Empty").show();
                    console.log("Id_Empty: show");
                }


                var url = '@Url.Action("Abilitaelementi", "Richiesta")';
                dato = { statoattuale: $('#Stato_Id').val() };
                console.log(dato);
                if (dato.statoattuale > 0) {
                    $("#loading").css("display", "block");
                    $.ajax({
                        url: url,
                        data: dato,
                        type: "POST",
                        dataType: "json",
                        error: function (xhr) {
                            $("#loading").css("display", "none");
                            alert('Error: ' + xhr.statusText);
                        },
                        success: function (data) {
                            $("#loading").css("display", "none");
                            $.map(data,
                                function(item) {
                                    ModificaElemento(item.Attributo, item.NomeElemento, item.NomeProprieta, item.ValoreProprieta);
                                });
                        }
                    });
                }


            }
