            function ModificaElemento(Attributo, NomeElemento, NomeProprieta, ValoreProprieta) {
                var ele = "[" + Attributo + "='" + NomeElemento + "']";
                console.log("Elemento:"+ele + " " + NomeProprieta + " " + ValoreProprieta);
                var elemento = $(ele);
                if (NomeProprieta == "hidden") {
                    if (ValoreProprieta == "false") { elemento.show(); } else
                    if (ValoreProprieta == "true") { elemento.hide(); }
                }
                if (ValoreProprieta == "false") { elemento.prop(NomeProprieta, false); } else
                if (ValoreProprieta == "true") { elemento.prop(NomeProprieta, true); } else
                    elemento.prop(NomeProprieta, ValoreProprieta);
            };

