<script type="text/javascript">

    function CovertiDataAspNet(item) {
        if ((item != null) && (String(item).substring(0, 5) == "/Date")) {

            @* $('#DataPagamento').val(new Date(Date.parse('@Model.DataPagamento')).format("yyyy-MM-dd"));
            $('#DataSottoscrizione').val(new Date(Date.parse('@Model.DataSottoscrizione')).format("yyyy-MM-dd"));*@

            item = String(item).replace("/Date(", "").replace(")/", "");
            var dateObj = new Date(+item);
            var month = dateObj.getMonth() + 1; //months from 1-12
            var day = dateObj.getDate();
            var year = dateObj.getFullYear();
            item = ("000" + day).slice(-2) + "/" + ("000" + month).slice(-2) + "/" + year;
            //console.log("data trovata:" + item);

        }
        return item;
    }

    function LogStati(id) {
        var url = '@Url.Action("LogStati", "Richiesta")';
                                dato = {
                                    id: id
                                };
                                console.log(dato);
                                $.ajax({
                                    url: url,
                                    data: dato,
                                    type: "POST",
                                    error: function (xhr) {
                                        alert('Error: ' + xhr.statusText);
                                    },
                                    success: function (result) {
                                        console.log("Genero tabella LogStati");
                                        var opt = {
                                            autoOpen: false,
                                            modal: true,
                                            width: "auto",
                                            height: "auto",
                                            title: 'Log Stati',
                                            buttons: {
                                                Close: function () {
                                                    $(this).dialog("close");
                                                    $(this).dialog("destroy");
                                                }
                                            },
                                        };
                                        $('#finestralogstati').html(result);
                                        $('#finestralogstati').dialog(opt).dialog('open');
                                    }
                                });
    }

    function Gestione(id) {
        var url = '@Url.Action("Gestione", "Richiesta")';
                                dato = {
                                    id: id
        };
        $("#loading").css("display", "block");
                                console.log(dato);
                                $.ajax({
                                    url: url,
                                    data: dato,
                                    type: "GET",
                                    error: function (xhr) {
                                        $("#loading").css("display", "none");
                                        alert('Error: ' + xhr.statusText);
                                    },
                                    success: function (result) {
                                        $("#loading").css("display", "none");
                                        console.log("Popolo div dettaglio");

                                        $('#dettaglio').html(result);

                                    }
                                });
    }

    function Dettagli(id) {
        var url = '@Url.Action("Details", "Richiesta")';
                                dato = {
                                    id: id
        };
        $("#loading").css("display", "block");
                                console.log(dato);
                                $.ajax({
                                    url: url,
                                    data: dato,
                                    type: "GET",
                                    error: function (xhr) {
                                        $("#loading").css("display", "none");
                                        alert('Error: ' + xhr.statusText);
                                    },
                                    success: function (result) {
                                        $("#loading").css("display", "none");
                                        console.log("Popolo div dettaglio");

                                        $('#dettaglio').html(result);

                                    }
                                });
    }

    function LeggiRichieste() {

        var data = @Html.Raw(Json.Encode(Model));

        $("#indexTable").DataTable({
            "language": {
                url: '@Url.Content("~/Scripts/DataTables/it_it.json")'
            },
            destroy: true,
            data: data,
            deferRender: true,
            scrollX: false,
            scrollY: 400,
            scrollCollapse: true,
            scroller: true,
            searching: true,
            paging: true,
            info: false,
            columnDefs: [
                {
                    //render: function (data, type, full, meta) {
                    //    return "<div style='white-space:normal; width:200px;'>" + data + "</div>";
                    //},
                    //targets: 3
                }
            ],
            "columns": [
                {
                    'data': null,
                    title: '',
                    wrap: true,
                    "orderable": false,
                    "render": function (item) {
                        var Id = "'" + item.Id + "'";
                        var urlimage = "'@Url.Content("~/Content/img/LogIcon.png")'";
                        //var html = '<button value="" onclick="LogStati(';
                        //html += Id + ')"><img src=' + urlimage + '></button>';
                        var html = '<img onclick="LogStati(';
                        html += Id + ')" src=' + urlimage + ' style="cursor: pointer;" />';
                        console.log("html:" + html);
                        return html;
                    }
                },
                { "data": "Protocollo", className: 'dt-body-center' },
                { "data": "NDG", className: 'dt-body-center' },
                {
                    "data": "IntestazioneNDG",
                    "render": function (item) {
                        return item.substring(0,40);
                    }
                },
                {
                    "data": "DataRichiesta", className: 'dt-body-center',
                    "render": function (item) {
                        return CovertiDataAspNet(item);
                    }
                },
                { "data": "GiorniAttesaBanca", className: 'dt-body-center' },
                /*{ "data": "GiorniAttesaCliente" },*/
                //{
                //    "data": "DataAvviso", className: 'dt-body-center',
                //    "render": function (item) {
                //        return CovertiDataAspNet(item);
                //    } },
                //{
                //    "data": "DataIIAvviso", className: 'dt-body-center',
                //    "render": function (item) {
                //        return CovertiDataAspNet(item);
                //    } },
                //{
                //    "data": "DataConsegna", className: 'dt-body-center',
                //    "render": function (item) {
                //        return CovertiDataAspNet(item);
                //    } },
                {
                    "data": "DataChiusa", className: 'dt-body-center',
                    "render": function (item) {
                        return CovertiDataAspNet(item);
                    } },
                //{ "data": "Filiale" },
                //{ "data": "Luogo" },
                { "data": "Addetto" },
                //{
                //    "data": "UltimaModifica", className: 'dt-body-center',
                //    "render": function (item) {
                //        return CovertiDataAspNet(item);
                //    }
                //},
                { "data": "Stato.Stato" },
                {
                    'data': null,
                    title: '',
                    wrap: true,
                    "orderable": false,
                    "render": function (item) {

                        var Id = "'" + item.Id + "'";
                        //console.log("Item Id:" + item.Id);
                        var urlimage = "'@Url.Content("~/Content/img/cerca.gif")'";
                        //var html = '<button value="" onclick="Dettagli(';
                        //html += Id + ')"><img src=' + urlimage + '></button>';
                        var html = '<img onclick="Dettagli(';
                        html += Id + ')" src=' + urlimage + ' style="cursor: pointer;" />';
                        //console.log("html:" + html);
                        return html;
                    }
                },
                {
                    'data': null,
                    title: '',
                    wrap: true,
                    "orderable": false,
                    "render": function (item) {

                        ///da valutare bene

                        if ((item.Istituto!="@ViewData["istituto"]")||(item.UOCodeNext !=  "@ViewData["uocode"]")) return '';
                        if (item.Stato.Chiuso) return '';
                        var Id = "'" + item.Id + "'";
                        //console.log("Item Id:" + item.Id);
                        var urlimage = "'@Url.Content("~/Content/img/edit_icon.png")'";
                        //var html = '<button value="" onclick="Gestione(';
                        //html += Id + ')"><img src=' + urlimage + '></button>';
                        var html = '<img onclick="Gestione(';
                        html += Id + ')" src=' + urlimage + ' style="cursor: pointer;" />';
                        //console.log("html:" + html);
                        return html;
                    }
                },
                @*{
                    'data': null,
                    title: '',
                    wrap: true,
                    "orderable": false,
                    "render": function (item) {
                        //console.log(item.Stato.Stato);
                        //console.log(item.UOCodeNext.UOCODE);
                        //console.log(item.Stato.Chiuso);
                        if ((item.Stato != null) && (item.Stato.Stato != "Inizio")) return '';
                        if (item.UOCodeNext.UOCODE != @ViewBag.MioUocode) return '';
                        if (item.Stato.Chiuso) return '';
                        /*console.log("Item Id:" + item.Id);*/
                        var url = "'@Url.Action("Delete", "Richiesta")"+"/"+ item.Id+"'";
                        //console.log("Url:" + url);
                        var html = '<input type="button" value="Cancella" onclick="location.href=';
                        html += url+ '" style="cursor: pointer;" />';
                        //console.log("html:" + html);
                        return html;
                    }
                },*@

            ],



        });
    };

