@model RCDWeb.Areas.RCD.Models.GestioneViewModel


<table class="TabellaDati">
    <tr>
        <td style="width:250px">
            @Html.DisplayNameFor(model => model.ModalitaPagamento)
            <div>
                @Html.DropDownListFor(model => model.ModalitaPagamento.Id, (IEnumerable<SelectListItem>)ViewBag.DropDownPagamento, "-- Seleziona --", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ModalitaPagamento, "", new { @class = "text-danger" })
            </div>
        </td>
        <td style="width: 305px ">
            <div class="numeroconto form-group">
                @Html.DisplayNameFor(model => model.NumeroConto)
                <div class="col-md-10">
                    @Html.EditorFor(model => model.NumeroConto, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.NumeroConto, "", new { @class = "text-danger" })
                </div>
            </div>
        </td>
        <td >
            @Html.DisplayNameFor(model => model.SpesaAddebitabile)
            <div class="col-md-10">
                <div class="checkbox">
                    @Html.CheckBoxFor(model => model.SpesaAddebitabile)
                    @Html.ValidationMessageFor(model => model.SpesaAddebitabile, "", new { @class = "text-danger" })
                </div>
            </div>
        </td>
        <td>
            <div class="spesa">
                <div class="DataPagamento form-group">
                    @Html.DisplayNameFor(model => model.DataPagamento)
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DataPagamento, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.DataPagamento, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </td>
    </tr>
</table>

<script type="text/javascript">
    $("#DataPagamento").kendoDatePicker({
        max: new Date()
    });
    function ControlloSpesa(value) {
        //console.log(value);
        if (value) {
            $('.spesa').show(); //show
            ControlloCostiCanali();
        }
        else {
            $('.spesa').hide(); //hide
        }
        
    };
    var SpesaAddebitabile = $("input#SpesaAddebitabile");
    ControlloSpesa(SpesaAddebitabile.is(':checked'));
    SpesaAddebitabile.unbind().click(function () {
        /*DocOrig.prop('checked', true);*/
        SpesaAddebitabile.val($(this).is(':checked'));
        console.log("SpesaAddebitabile:" + $(this).is(':checked') + ":" + $(this).val());
        ControlloSpesa($(this).is(':checked'));
    });

</script>