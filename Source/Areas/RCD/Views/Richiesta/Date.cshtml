<div id="resultInfo" class="" style="display: none"></div>
<script>
    //Fix
    $(function () {
        var CanaleRicezione = $("select#CanaleRicezione_Id");
        //visualizzare solo e richiesta = email -> consegna=filiale
        if (CanaleRicezione.val() != "@ViewBag.CanaleEmailID") {
            $(".DataIIAvviso2").hide();
            $(".DataIIAvviso").hide();
        }

    });

</script>


<script>
    $("#DataConsegna").kendoDatePicker({
        max: new Date()
    });
    $("#DataAvviso").kendoDatePicker({
        max: new Date()
    });
    $("#DataIIAvviso").kendoDatePicker({
        max: new Date()
    });
   
    $(".info_dataavviso").click(function () {
        InfoDate(
            "Digitare, a seconda del canale di comunicazione utilizzato: <br/>" +
            "- la data di avvenuta consegna della Raccomandata / PEC <br/>"+
            "- la data di invio dell’email <br/>"+
            "relativa alla comunicazione di giacenza dei documenti trasmessa al richiedente", "Data Avviso Giacenza"
        );
    });
    $(".info_dataconsegna").click(function () {
        InfoDate(
            "Digitare, a seconda del canale di consegna della documentazione:<br/>" +
            "- la data di consegna della documentazione presso la filiale <br/>" +
            "- la data di avvenuta consegna della Raccomandata / PEC di invio documentazione.", "Data Consegna"
        );
    });
    



    function InfoDate(message, titolo) {
        if (message.length > 0) {
            $("#resultInfo").empty();
            
            $("<div>").html(message).appendTo("#resultInfo");
            $("#resultInfo").scrollTop(0);
            var opt = {
                autoOpen: false,
                modal: true,
                width: "auto",
                height: "auto",
                title: titolo,
                buttons: {
                    Chiudi: function () {
                        $(this).dialog("close");
                        $(this).dialog("destroy");
                    }
                },
            };
            $('#resultInfo').dialog(opt).dialog('open');
        }
    };
</script>



