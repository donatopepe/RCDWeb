<style type="text/css">
    textarea, select {
        font-family: "Trebuchet MS", Verdana, Arial, Helvetica, sans-serif;
        font-size: 12px;
    }
    .bottone_documenti_rcd {
        background: url('@Url.Content("~/Content/img/ico_word.png")') no-repeat;
        border-radius: 10px;
        color: gray;
        border: 1px solid;
