            color: gray;
            margin-left: 10px;
            margin-top: 50px;
        }

    .altezza_row {
        height: 40px;
    }

    table.detailsTable {
        border: 2px solid #1C6EA4;
        background-color: #EEEEEE;
        width: 100%;
        text-align: center;
        border-collapse: collapse;
    }

