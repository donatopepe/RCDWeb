@using (Html.BeginForm("Gestione", "Richiesta", new { }, FormMethod.Post, new { enctype = "multipart/form-data", id = "RichiestaForm" }))
{
    //@Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.Stato.Id)
    @Html.HiddenFor(model => model.UOCode)
    @Html.HiddenFor(model => model.UOCodeNext)
    @Html.HiddenFor(model => model.Matricola)
    @Html.HiddenFor(model => model.Motivazione)
    @Html.HiddenFor(model => model.UOCode_Inoltro)
    @Html.HiddenFor(model => model.FilialeUOcode)

    <div>

        @Html.Partial("Anagrafica", Model)

        <fieldset>
            <legend class="testo_ordine_red">Dati</legend>

            @Html.Partial("Canali", Model)

            @Html.Partial("DatiRichiedente", Model)
        </fieldset>

        <br />
        @Html.Partial("DocumentiStart", Model)

        <br />
        @Html.Partial("AllegatiStart", Model)
        <br />

        <div class="Id_Empty">
            @if ((ViewData["Motivazione"] != null) && (!String.IsNullOrWhiteSpace(ViewData["Motivazione"].ToString())))
            {
                @Html.LabelFor(model => model.Motivazione, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.Label(@ViewData["Motivazione"] == null ? "" : (string)@ViewData["Motivazione"])
            }
        </div>

        @Html.Partial("Date", Model)

        @Html.Partial("Filiale", Model)

        @Html.Partial("InfoFooter", Model)

    </div>

    <br />

    <table>
        <tr>
            <td>
                <div id="BottoniCambioStato" />
            </td>
        </tr>

    </table>


</div>
}


