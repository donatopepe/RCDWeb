<script>
    function Chiudi() {
        $("#elencoRich").empty();
        $("#dettaglio").empty();
        $("#elencoNdg").empty();
        $("#sceltaNdg").empty();
        $('form[data-ajax-update="#elencoRich"] :submit').trigger("click");
    }
</script>

<script type="text/javascript">

    var CanaleConsegna = $("select#CanaleConsegna_Id");

    function numeroconvirgola(value) {
        value = value.replace('.', ',').replace(/[^0-9,]/g, '').replace(/(\..*)\./g, '$1');
        return value;
    }

    function numerosenzavirgola(value) {
        value = value.replace(/[^0-9]/g, '').replace(/(\..*)\./g, '$1');
        return value;
    }


    $(document).ready(function () {

        $("#Costo").change(function (e) {
            $(this).val(numeroconvirgola($(e.target).val()));
        });
        $("#Costo").on("input", function (e) {
            $(this).val(numeroconvirgola($(e.target).val()));
        });
        $("#NumCopie").on("input", function (e) {
            $(this).val(numerosenzavirgola($(e.target).val()));
        });
    });
</script>