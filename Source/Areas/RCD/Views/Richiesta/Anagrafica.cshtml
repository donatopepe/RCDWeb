                                        @Html.ValidationMessage("Cointestatari[" + i + "].LuogoNascita")
                                    </b>
                                </td>
                                <td>
                                    @*<div class="form-group">
                                            @Html.LabelFor(model => model.Cointestatari.FirstOrDefault().DataNascita, htmlAttributes: new { @class = "control-label col-md-2" })
                                            <div class="col-md-10">
                                                @Html.EditorFor(model => model.Cointestatari.FirstOrDefault().DataNascita, new { htmlAttributes = new { @class = "form-control" } })
                                                @Html.ValidationMessageFor(model => model.Cointestatari.FirstOrDefault().DataNascita, "", new { @class = "text-danger" })
                                            </div>
                                        </div>*@
                                    @if (item.DataNascita.HasValue)
                                    {

                                        @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().DataNascita)
                                        <br />
                                        <b>
                                            @Html.Hidden("Cointestatari[" + i + "].DataNascita", item.DataNascita)
                                            @item.DataNascita.GetValueOrDefault().ToString("dd/MM/yyyy")
                                        </b>

                                    }
                                </td>
                                <td>

                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().Indirizzo)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].Indirizzo", item.Indirizzo)
                                        @Html.TextBox("Cointestatari[" + i + "].Indirizzo", item.Indirizzo, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].Indirizzo")
                                    </b>
                                </td>
                            </tr>
                        </table>
                    </fieldset>

                }
                else
                {
                    <fieldset>
                        <legend>Società</legend>
                        <table class="TabellaDati">
                            <tr>
                                <td>
                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().IntestazioneNDG)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].IntestazioneNDG", item.IntestazioneNDG)
                                        @Html.TextBox("Cointestatari[" + i + "].IntestazioneNDG", item.IntestazioneNDG, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].IntestazioneNDG")
                                    </b>
                                </td>
                                <td>
                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().PIva)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].PIva", item.PIva)
                                        @Html.TextBox("Cointestatari[" + i + "].PIva", item.PIva, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].PIva")
                                    </b>

                                </td>
                                <td>

                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().SedeLegale)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].SedeLegale", item.SedeLegale)
                                        @Html.TextBox("Cointestatari[" + i + "].SedeLegale", item.SedeLegale, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].SedeLegale")
                                    </b>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().IscrizioneCCIAA)
                                    <br />
                                    <b>
                                        @Html.TextBox("Cointestatari[" + i + "].IscrizioneCCIAA", item.IscrizioneCCIAA, new { })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].IscrizioneCCIAA")
                                    </b>

                                </td>
                                <td>
                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().AlboProfessionale)
                                    <br />
                                    <b>
                                        @Html.TextBox("Cointestatari[" + i + "].AlboProfessionale", item.AlboProfessionale, new { })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].AlboProfessionale")
                                    </b>
                                </td>
                                <td>

                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().Indirizzo)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].Indirizzo", item.Indirizzo)
                                        @Html.TextBox("Cointestatari[" + i + "].Indirizzo", item.Indirizzo, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].Indirizzo")
                                    </b>

                                </td>
                            </tr>
                        </table>

                    </fieldset>

                }

                i++;


            }


        </fieldset>
        <br />
    }
}




