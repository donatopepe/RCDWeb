@{
    int i = 0;
    if ((Model.Cointestatari != null) && (Model.Cointestatari.Count() > 0))
    {
        <fieldset>
            <legend>Cointestatari</legend>
            @foreach (var item in Model.Cointestatari)
            {

                @Html.Hidden("Cointestatari[" + i + "].Id", item.Id)
                @Html.Hidden("Cointestatari[" + i + "].NaturaGiuridica", item.NaturaGiuridica)
                @Html.Hidden("Cointestatari[" + i + "].isPerson", item.isPerson)
                @Html.Hidden("Cointestatari[" + i + "].NDG", item.NDG)
                if (item.isPerson)
                {
                    <fieldset>
                        <legend>Persona fisica</legend>
                        <table class="TabellaDati">
                            <tr>
                                <td>

                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().IntestazioneNDG)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].IntestazioneNDG", item.IntestazioneNDG)
                                        @Html.TextBox("Cointestatari[" + i + "].IntestazioneNDG", item.IntestazioneNDG, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].IntestazioneNDG")
                                    </b>

                                </td>
                                <td>

                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().CodiceFiscale)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].CodiceFiscale", item.CodiceFiscale)
                                        @Html.TextBox("Cointestatari[" + i + "].CodiceFiscale", item.CodiceFiscale, new { @disabled = "@disabled", @readonly = "readonly" })
                                        @Html.ValidationMessage("Cointestatari[" + i + "].CodiceFiscale")
                                    </b>

                                </td>

                                <td>
                                    @Html.DisplayNameFor(model => model.Cointestatari.FirstOrDefault().LuogoNascita)
                                    <br />
                                    <b>
                                        @Html.Hidden("Cointestatari[" + i + "].LuogoNascita", item.LuogoNascita)
